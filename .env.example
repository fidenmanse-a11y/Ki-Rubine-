# Rubine AI configuration. Copy to .env (scripts/setup does this for you).
# NEVER commit .env – it contains your password and optional API keys.

# Login password for the app (min. 8 characters). Required.
RUBINE_ADMIN_PASSWORD=

# Server: 0.0.0.0 = reachable from your iPhone in the same WLAN.
RUBINE_HOST=0.0.0.0
RUBINE_PORT=8000
# Optional HTTPS (e.g. certificates from mkcert or `tailscale cert`)
# RUBINE_SSL_CERTFILE=C:\path\to\cert.pem
# RUBINE_SSL_KEYFILE=C:\path\to\key.pem
# Extra origins allowed for POST requests behind a reverse proxy (JSON list)
# RUBINE_ALLOWED_ORIGINS=["https://mein-pc.tailnet-name.ts.net"]

# Base model (Apache-2.0). Revision is pinned for reproducible training.
RUBINE_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
RUBINE_BASE_MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
RUBINE_DEVICE=auto

# Storage (default: ./data with SQLite). PostgreSQL example:
# RUBINE_DATABASE_URL=postgresql+psycopg://rubine:secret@localhost:5432/rubine

# Rubine World 2.0 (society simulation)
RUBINE_WORLD2_ENABLED=true
RUBINE_WORLD2_AUTOSTART=true
# Residents may use the Rubine model for significant decisions (rules decide otherwise)
RUBINE_WORLD2_LLM=true
# Frozen evaluation sets (eval-sim-v1 is built from a separate, held-out simulation world)
RUBINE_EVAL_SETS=eval-v1,eval-sim-v1

# Classic v0.1 town simulation (optional)
RUBINE_SIM_ENABLED=false
RUBINE_SIM_TICK_SECONDS=2.0
# Agents think with the active Rubine model ("rubine") or an OpenAI-compatible server
RUBINE_AGENT_BACKEND=rubine

# Teachers (all optional)
# Local open-weight teacher via Ollama / llama.cpp / LM Studio / vLLM:
# RUBINE_TEACHER_OPENAI_BASE_URL=http://localhost:11434/v1
# RUBINE_TEACHER_OPENAI_MODEL=qwen2.5:7b-instruct
# Larger Hugging Face model loaded in the job process:
# RUBINE_TEACHER_LOCAL_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Anthropic API (paid, your own key; a Claude subscription does not include API access):
# RUBINE_ANTHROPIC_API_KEY=
# RUBINE_ANTHROPIC_MODEL=claude-opus-5-5

# Limits
RUBINE_MAX_TRAIN_STEPS=5000
RUBINE_MAX_SEQ_LEN=512
RUBINE_MAX_SELF_GENERATED_FRACTION=0.5
RUBINE_EVAL_SET_SIZE=64
